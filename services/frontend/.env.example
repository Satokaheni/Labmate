# WebSocket gateway URL.
# Local dev (default):  ws://localhost:8787/ws
# RunPod remote:        ws://<pod-id>.runpod.net:8787/ws
# Production (TLS):     wss://labmate.yourdomain.com/ws
VITE_WS_URL=ws://localhost:8787/ws

# Electron only: root directory the local tool executor is confined to.
# read_file/write_file/list_dir cannot escape this path. Defaults to $HOME.
LABMATE_WORKSPACE=/Users/you/Work
