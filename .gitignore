# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*

# ─── Runtime data (Mongo / Redis / Chroma / logs / pids) ──────────────────────
.data/

# ─── Local / machine-specific config ─────────────────────────────────────────
.claude/settings.local.json
.env
.env.*
!.env.example

# ─── Models, weights & large artifacts ────────────────────────────────────────
# These normally live OUTSIDE the repo (/workspace/models, /workspace/.hf-cache,
# /workspace/llama.cpp). Listed here defensively so they can never be committed.
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
models/
.hf-cache/
llama.cpp/

# ─── Archives ─────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz

# ─── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
*.swp
