# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/

# ─── Node ─────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
*.tsbuildinfo
# Build output (regenerated by `npm run build`) and npm lockfiles — not tracked.
# Fresh clones must run a build (install.sh / `npm run build`) before serving.
dist/
package-lock.json
# Vite emits these when tsc --declaration is run outside of vite build
services/frontend/vite.config.js
services/frontend/vite.config.d.ts
services/frontend/tailwind.config.js
services/frontend/tailwind.config.d.ts

# ─── Runtime data (Mongo / Redis / Chroma / logs / pids) ──────────────────────
.data/
services/skills/.skill_telemetry.json

# ─── Local / machine-specific config ─────────────────────────────────────────
.claude/settings.local.json
.env
.env.*
!.env.example
# Personal gateway URL / dev overrides (Piece 7b) — see config.example.ts for the
# committed template; config.ts is auto-provisioned from it (predev/prebuild/CI).
services/frontend/src/config.ts

# ─── Models, weights & large artifacts ────────────────────────────────────────
# These normally live OUTSIDE the repo (/workspace/models, /workspace/.hf-cache,
# /workspace/llama.cpp). Listed here defensively so they can never be committed.
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
models/
.hf-cache/
llama.cpp/

# ─── Archives ─────────────────────────────────────────────────────────────────
*.zip
*.tar.gz
*.tgz

# ─── OS / editor cruft ────────────────────────────────────────────────────────
.DS_Store
*.swp
