# local.env — connection settings for the NATIVE (no-Docker) support stack.
#
# This pod cannot run containers (no NET_ADMIN / blocked unshare syscalls), so
# MongoDB, Redis, and Chroma run as plain host processes instead of Docker
# services. Source this before running the orchestrator / tests against the
# local stack:
#
#   source infrastructure/local/local.env
#
# Differences from the Docker stack (infrastructure/docker/docker-compose.yml):
#   - Hostnames are localhost, not the Docker DNS names (mongodb/chroma/redis).
#   - Chroma listens on :8765 (loopback). NOT :8000 (reserved for host vLLM) and
#     NOT :8001 (RunPod's nginx proxy already binds :8001 on this pod).
#   - MongoDB runs as a single-node replica set (rs0) so change streams work
#     (the StorageManager outbox worker uses db.messages.watch()).

export MONGO_URI="mongodb://localhost:27017/labmate?replicaSet=rs0"
export CHROMA_HOST="localhost"
export CHROMA_PORT="8765"
export CHROMA_URL="http://localhost:8765"
export REDIS_URL="redis://localhost:6379/0"

# SearXNG metasearch (native, for the web-search skill — it calls /search?format=json).
# Runs natively on this pod (no Docker). In the Docker stack the skill instead uses
# http://searxng:8080 via the compose network (see docker-compose.yml).
export SEARXNG_URL="http://localhost:8080"

# Host vLLM (model served directly on the host, not in a container).
export INFERENCE_URL="http://localhost:8000"

# Per-request context window (orchestrator gauge + auto-compact thresholds) — FALLBACK ONLY.
# The orchestrator now queries llama-server's /props at startup for the actual loaded
# per-slot window (= serve-model.sh --ctx-size / --parallel), so the gauge tracks the served
# model automatically and this value normally does NOT need hand-syncing on a model swap.
# It is used only if that query fails (llama-server unreachable). Kept aligned with the
# --swa-full default (12B: --ctx-size 262144 --parallel 1 = 262144 tokens/request) as a
# sane fallback; 131072 is the last-resort default if this is unset too.
export CTX_WINDOW="${CTX_WINDOW:-262144}"

# LLM API bases (vLLM OpenAI-compatible endpoints).
# On single-GPU, QWEN_BASE == GEMMA_BASE (Gemma 4 serves both roles).
export GEMMA_BASE="http://localhost:8000/v1"
export QWEN_BASE="${QWEN_BASE:-$GEMMA_BASE}"

# Served model (single source of truth — serve-model.sh sources this file). The 12B is
# the default: ~2x faster than the 31B, routes better after the prompt fix (0.989 vs
# 0.977), and its per-model --swa-full CTX (serve-model.sh) fits the FULL 262144 trained
# context on the 48GB card (the 31B is capped ~65536). Override MODEL=<path> to switch.
export MODEL="${MODEL:-/workspace/models/gemma-4-12b-gguf/gemma-4-12b-it-UD-Q4_K_XL.gguf}"

# Tokenizer for the ast-repo-map skill's token budgeting (Gemma SentencePiece;
# never tiktoken). install.sh downloads the tokenizer files here. Local path =
# offline + deterministic; if missing, the skill falls back to the HF id
# google/gemma-4-31B-it (network), then to a char estimate.
export REPO_MAP_TOKENIZER="${REPO_MAP_TOKENIZER:-/workspace/models/gemma-4-gguf/tokenizer}"

# Orchestrator runtime.
export WORKSPACE_PATH="${WORKSPACE_PATH:-/workspace}"
export SANDBOX_CONTAINER="${SANDBOX_CONTAINER:-}"   # empty on RunPod (no Docker)

# Sequencing mode (read once at orchestrator startup). `react` always uses the
# multi-tool ReAct loop, so compound tasks ("find X, then review it") can chain
# find -> read -> review instead of stopping at a single skill. Set to
# `skill_first` for the one-skill-per-goal fast path.
export SEQUENCING_MODE="${SEQUENCING_MODE:-react}"

# Conditional gates: skip the LLM ambiguity gate and/or the verify/critique gate
# for clearly trivial, low-risk tasks (e.g. "What is 2+2?"). OFF by default —
# unset or set to 0/false to preserve current always-gated behavior.
export ENABLE_CONDITIONAL_GATES="0"
# Max word count for a task to be eligible as "trivial" (conservative; default 12).
export TRIVIAL_MAX_WORDS="12"

# Routing pre-gate: an embed-based (bge-small) plausibility check that runs BEFORE
# the LLM routing vote. When no catalog skill is plausibly relevant, it skips the
# 3-sample vote entirely and goes straight to a direct answer — dropping pre-answer
# latency toward the assess-only floor (measured ~19s -> ~1.5s on a no-skill query
# like "what is the traveling salesman problem"). Fail-safe: any embed error proceeds
# to the full vote. The CODE default is OFF (keeps CI embed-free); this turns it ON in
# production. Threshold validated at 0.58 (0% false-skip, 66.7% correct-skip; see
# eval/pregate_recall_eval.py). Set PREGATE_SIM_THRESHOLD=0.60 for more skips (88.9%)
# at ~1.2% false-skip.
export ENABLE_ROUTING_PREGATE="${ENABLE_ROUTING_PREGATE:-1}"
export PREGATE_SIM_THRESHOLD="${PREGATE_SIM_THRESHOLD:-0.58}"

# ws_gateway — CLI and Electron connect here via WebSocket.
# JWT_SECRET: use a long random string in production (openssl rand -hex 32).
# ADMIN_EMAIL / ADMIN_PASSWORD: your account, seeded once on first boot.
export LABMATE_GATEWAY_URL="ws://localhost:8787/ws"
export JWT_SECRET="${JWT_SECRET:-dev-insecure-secret-change-me}"
export ADMIN_EMAIL="${ADMIN_EMAIL:-}"
export ADMIN_PASSWORD="${ADMIN_PASSWORD:-}"
export MONGO_URL="mongodb://localhost:27017"
# Browser origins allowed to call the gateway's REST endpoints (CORS preflight).
# The Vite dev server serves the frontend on :8080 (see services/frontend/vite.config.ts),
# so that origin MUST be listed or the /auth/login preflight (OPTIONS) returns 400
# and the browser never sends the login POST. 5173 is Vite's default for other setups.
export CORS_ORIGINS="http://localhost:8080,http://localhost:5173,http://localhost:8787"

# dataset-search GitHub source (optional). Unset = unauthenticated search (~10
# req/min); a scopeless token raises it to 30/min. Get one at
# https://github.com/settings/tokens (no scopes needed for public repo search).
# export GITHUB_TOKEN=""

# Discord connector (optional— leave unset to skip the connector).
# export DISCORD_BOT_TOKEN=""
# export DISCORD_WEBHOOK_URL=""
# export DISCORD_DEV_GUILD_ID=""
# export DISCORD_EDIT_INTERVAL="1.0"
